<policies>
    <inbound>
        <base />
        <!-- 1. Dynamic Model Routing based on Task Header -->
        <set-variable name="taskType" value='@(context.Request.Headers.GetValueOrDefault("X-Task-Type", context.Request.Headers.GetValueOrDefault("X-Enterprise-Task-Type", context.Request.Headers.GetValueOrDefault("X-EY-Task-Type", ""))))' />
        <choose>
            <when condition='@(((string)context.Variables["taskType"]).Equals("bulk-extraction", StringComparison.OrdinalIgnoreCase))'>
                <set-backend-service base-url="https://your-resource-name.openai.azure.com/openai/deployments/gpt-4o-mini" />
            </when>
            <otherwise>
                <set-backend-service base-url="https://your-resource-name.openai.azure.com/openai/deployments/o1-preview" />
            </otherwise>
        </choose>

        <!-- 2. Mandatory ERP / SAP Engagement WBS Billing Header -->
        <set-variable name="wbsElement" value='@(context.Request.Headers.GetValueOrDefault("X-EY-WBS-Element", context.Request.Headers.GetValueOrDefault("X-WBS-Element", context.Request.Headers.GetValueOrDefault("X-Cost-Center", context.Request.Headers.GetValueOrDefault("X-Billing-ID", "")))))' />
        <choose condition='@(!((string)context.Variables["wbsElement"]).StartsWith("WBS-"))'>
            <return-response>
                <set-status code="400" reason="Bad Request" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-body>@("{\"error\":\"Missing or invalid X-EY-WBS-Element billing identifier\"}")</set-body>
            </return-response>
        </choose>
        <set-header name="X-EY-WBS-Element" exists-action="override">
            <value>@((string)context.Variables["wbsElement"])</value>
        </set-header>

        <!-- 3. Enterprise Rate Limiting & Security Guardrail -->
        <rate-limit calls="500" renewal-period="60" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
