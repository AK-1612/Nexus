{
  "openapi": "3.0.1",
  "info": {
    "title": "Enterprise Azure OpenAI Gateway API",
    "version": "2024-08-01-preview",
    "description": "Standardized enterprise API for Dynamic Model Routing and ERP WBS Billing"
  },
  "paths": {
    "/chat/completions": {
      "post": {
        "summary": "Create chat completion with dynamic model routing",
        "operationId": "createChatCompletion",
        "parameters": [
          {
            "name": "X-Task-Type",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Routing classifier (bulk-extraction, standard, statutory-audit)"
          },
          {
            "name": "X-WBS-Element",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "SAP / ERP Cost-Center WBS billing element"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful chat completion"
          }
        }
      }
    }
  }
}
